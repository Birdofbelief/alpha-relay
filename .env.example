# ============================================================
# signal-chain 环境变量模板
#
#   用法：复制成 .env 后填入你自己的值（.env 已被 .gitignore 挡住）。
#   ★ **这个模板文件本身必须永远是空的** —— 它会被提交进公开仓库。
#     往这里填真值 = 直接泄漏，而且进了 git 历史就删不掉了。
#
#   不需要 Gist 后端的话，什么都不用填：
#     py -m signalchain.demo        # 零凭据、零网络
# ============================================================

# ---------- Gist 传输后端（transport=gist 时需要）----------
# Gist 的 ID，形如 https://gist.github.com/<用户名>/<这一段> 里的最后一段。
# ★ 把它当作凭据对待：secret gist **不是 private**，它是「不被检索到」，
#   不是「访问不了」—— 知道 ID 的人就能读。别贴进聊天记录、别进截图。
SC_GIST_ID=

# 有 gist 权限的 GitHub token。
# ★ 最小权限：只需要 gist 这一个 scope，不要用全权限 token。
SC_GITHUB_TOKEN=

# ---------- 通知（可选）----------
# ServerChan 的 SendKey；不填则只打印到控制台。
SC_SERVERCHAN_KEY=

# ---------- 策略（可选）----------
# 从**仓库外**加载你的私有策略。留空则用内置示例策略。
# ★ 真策略放在这个仓库之外 —— .gitignore 只兜底，真正的保障是它根本不在仓库里。
SC_STRATEGY_PATH=

# ---------- 可选覆盖 ----------
# 传输后端：file（默认，零凭据）| gist | null
# SC_TRANSPORT=file
#
# 本进程扮演的角色：producer | executor。
# ★ 两个角色能写的 channel 不同，写错会直接抛异常（见 docs/WIRE_CONTRACT.md）。
# SC_ROLE=producer
#
# 运行时目录（文件后端与状态落盘的位置）
# SC_RUNTIME_DIR=./runtime
#
# 单次 HTTP 请求超时（秒）。行情、Gist 共用。
# ★ 不要设得太大：一个卡住的请求会吃掉整个交易窗口的时间预算。
# SC_HTTP_TIMEOUT=15.0
#
# 持仓快照的保鲜期（秒）—— 超过就认为该重新对账。
# SC_SNAPSHOT_TTL=300.0
#
# 历史缓存允许落后几个交易日；超了就跳过该标的（见 docs/DESIGN_NOTES.md 第五节）。
# ★ 调到 0 = 只用当天的数据，缓存基本失效；调大 = 容忍旧价。
# SC_MAX_STALE_DAYS=1
#
# 补执行窗口（分钟）—— 错过计划时刻后多久之内还补跑，超了就跳过当天。
# ★ 这个值决定了「进程重启晚了还能不能救回当天」。收盘后补执行没有意义。
# SC_CATCHUP_MINUTES=30
#
# 单任务当天连续失败上限 —— 到上限就放弃当天、心跳置 error 等人工处理。
# ★ 与主循环间隔（30 秒）相乘就是放弃前的窗口：默认 3 × 30s = 90 秒。
#   详见 docs/DESIGN_NOTES.md 第三节「一个已知的锋利边缘」。
# SC_TASK_FAIL_LIMIT=3
